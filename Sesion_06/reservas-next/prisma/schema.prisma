// Definición de la base de datos del hotel.
// Reglas que garantiza la BD: unicidad (@unique) y claves foráneas (@relation).
// Reglas que garantiza el servidor: fechas, capacidad, cruces de reservas y totales
// (ver features/*/domain y PrismaReservationRepository).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// La URL de conexión se define en prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  STAFF
  ADMIN
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
  FAMILY
}

// PENDING → CONFIRMED (pago) → COMPLETED (check-out)
// PENDING | CONFIRMED → CANCELLED
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// PENDING → PAID → REFUNDED (devolución)
// PENDING → FAILED
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  YAPE
  PLIN
  TRANSFER
  CASH
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  role         Role      @default(GUEST)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  bookings     Booking[]
  reviews      Review[]

  @@map("users")
}

model Room {
  id            String    @id @default(cuid())
  number        String    @unique
  name          String
  description   String?
  type          RoomType
  capacity      Int
  pricePerNight Decimal   @map("price_per_night") @db.Decimal(10, 2)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  amenities     Amenity[]
  bookings      Booking[]

  @@map("rooms")
}

model Amenity {
  id    String  @id @default(cuid())
  name  String  @unique
  icon  String?
  rooms Room[]

  @@map("amenities")
}

model Booking {
  id          String        @id @default(cuid())
  code        String        @unique
  userId      String        @map("user_id")
  roomId      String        @map("room_id")
  checkIn     DateTime      @map("check_in") @db.Date
  checkOut    DateTime      @map("check_out") @db.Date
  guests      Int
  nightlyRate Decimal       @map("nightly_rate") @db.Decimal(10, 2)
  totalAmount Decimal       @map("total_amount") @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User          @relation(fields: [userId], references: [id])
  room        Room          @relation(fields: [roomId], references: [id])
  payments    Payment[]
  review      Review?

  @@index([roomId, checkIn, checkOut])
  @@index([userId])
  @@map("bookings")
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @map("booking_id")
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("PEN") @db.Char(3)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  providerRef    String?       @unique @map("provider_ref")
  idempotencyKey String        @unique @map("idempotency_key")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  booking        Booking       @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("payments")
}

// Una reseña por reserva (bookingId @unique). Que la reserva esté COMPLETED
// lo valida el servidor al crear la reseña.
model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique @map("booking_id")
  userId    String   @map("user_id")
  rating    Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("reviews")
}
